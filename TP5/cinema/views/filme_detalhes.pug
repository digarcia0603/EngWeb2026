extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Detalhes do Filme: #{filme.title}
    
    .w3-container.w3-margin-top
      ul.w3-ul.w3-card-4
        li
          b ID: 
          span= filme.id
        li
          b Título: 
          span= filme.title
        li
          b Ano: 
          span= filme.year
      
      h3 Elenco (Cast)
      if filme.cast && filme.cast.length > 0
        ul.w3-ul.w3-card-4
          each ator in filme.cast
            li
              a(href=`/atores/${ator}`)= ator
      else
        p Não há informações sobre o elenco.

      h3 Géneros
      if filme.genres && filme.genres.length > 0
        ul.w3-ul.w3-card-4
          each genero in filme.genres
            li
              a(href=`/genero/${genero}`)= genero
      else
        p Não há informações sobre os géneros.

    footer.w3-container.w3-teal.w3-margin-top
      a.w3-button.w3-white.w3-margin(href="/filmes") Voltar à página principal