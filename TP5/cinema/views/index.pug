extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Training Records List 
        a.w3-btn.w3-round.w3-grey(href="/treinos/register") +
    
    .w3-container
      table.w3-table-all.w3-margin-top
        tr
          th Data
          th Nome
          th Modalidade
          th Resultado
          th Operações
        each e in list
          tr
            td= e.nome.primeiro + e.nome.último
            td= e.dataEMD
            td= e.modalidade
            td= e.resultado
            td
              a.w3-btn.w3-round.w3-blue-grey.w3-small(href=`/emd/edit/${e.id}`) Edit
              a.w3-btn.w3-round.w3-red.w3-small.w3-margin-left(href=`/emd/delete/${e.id}`) Delete