extends layout

block content 
    .w3-card-4
    header.w3-container.w3-teal
      h1 Tabela de Filmes
      a.w3-button.w3-blue.w3-margin-bottom(href="/atores") Ver Lista de Atores
      a.w3-button.w3-blue.w3-margin-bottom.w3-margin-left(href="/genero") Ver Lista de Géneros
    
    
    .w3-container
      table.w3-table-all.w3-margin-top.w3-hoverable
        tr
          th ID
          th Título
          th Ano
          th # Géneros
          th # Cast
        
        each f in list
          tr(onclick=`window.location='/filmes/${f.id}'` style="cursor:pointer")
            td= f.id
            td= f.title
            td= f.year
            td= f.genres ? f.genres.length : 0
            td= f.cast ? f.cast.length : 0

    footer.w3-container.w3-teal.w3-margin-top
      h5 Generated by EngWeb2026