extends layout 

block content 
    .w3-card-4
        header.w3-container.w3-teal
            h1 Tabela de Generos
            a.w3-button.w3-blue.w3-margin-bottom(href="/filmes") Voltar aos Filmes
        
        .w3-container
            table.w3-table-all.w3-margin-top.w3-hoverable
                tr
                    th Género
                    th Número de Filmes
                
                each a in list
                    tr(onclick=`window.location='/genero/${a.nome}'` style="cursor:pointer")
                        td= a.nome
                        td= a.numFilmes

        footer.w3-container.w3-teal.w3-margin-top
            h5 Generated by EngWeb2026