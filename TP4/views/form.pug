extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Registar Novo Exame Médico
    
    // O formulário vai enviar um pedido POST para a rota /emd/registo
    form.w3-container.w3-padding(method="POST" action="/emd/registo")
      fieldset.w3-margin-bottom
        legend Dados Pessoais
        label Primeiro Nome
        input.w3-input.w3-border(type="text" name="primeiro" required)
        
        label Último Nome
        input.w3-input.w3-border(type="text" name="último" required)
        
        label Idade
        input.w3-input.w3-border(type="number" name="idade" required)
        
        label Género
        select.w3-select.w3-border(name="género" required)
          option(value="" disabled selected) Escolha o género
          option(value="M") Masculino
          option(value="F") Feminino
          
        label Morada
        input.w3-input.w3-border(type="text" name="morada" required)
        
        label Email
        input.w3-input.w3-border(type="email" name="email" required)

      fieldset.w3-margin-bottom
        legend Dados Desportivos e Exame
        label Data do Exame
        input.w3-input.w3-border(type="date" name="dataEMD" required)
        
        label Modalidade
        input.w3-input.w3-border(type="text" name="modalidade" required)
        
        label Clube
        input.w3-input.w3-border(type="text" name="clube" required)
        
        label Federado?
        select.w3-select.w3-border(name="federado" required)
          option(value="true") Sim
          option(value="false") Não
          
        label Resultado
        select.w3-select.w3-border(name="resultado" required)
          option(value="true") Apto
          option(value="false") Não Apto

      button.w3-btn.w3-teal.w3-margin-top(type="submit") Registar
      a.w3-btn.w3-red.w3-margin-top.w3-margin-left(href="/") Cancelar