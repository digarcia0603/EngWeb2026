extends layout

block content
  .w3-container.w3-teal
    h1 Ator: #{ator.nome}
  .w3-container.w3-margin-top
    ul.w3-ul.w3-card-4
      li
        b ID: 
        | #{ator._id}
      li
        b Nome: 
        | #{ator.nome}
      li
        b Filmes em que participou:
        ul
          each f in ator.filmes
            li= f.title
    br
    a.w3-button.w3-teal(href="/atores") Voltar aos Atores