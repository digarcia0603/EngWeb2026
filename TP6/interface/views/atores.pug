extends layout

block content
  .w3-container.w3-teal
    h1 Lista de Atores
  .w3-container
    table.w3-table-all.w3-margin-top
      tr.w3-teal
        th ID
        th Nome
        th N.º Filmes
      each a in atores
        tr
          td= a._id
          td
            a(href="/atores/" + a._id)= a.nome
          td= a.filmes ? a.filmes.length : 0
    br
    a.w3-button.w3-teal(href="/") Voltar