extends layout

block content
  .w3-container.w3-teal
    h1 Lista de Filmes
  .w3-container
    table.w3-table-all.w3-margin-top
      tr.w3-teal
        th ID
        th Título
        th Ano
        th N.º Atores
        th N.º Géneros
      each f in filmes
        tr
          td= f._id
          td
            a(href="/filmes/" + f._id)= f.title
          td= f.year
          td= f.cast ? f.cast.length : 0
          td= f.genres ? f.genres.length : 0
    br
    a.w3-button.w3-teal(href="/") Voltar