extends layout

block content
  .w3-container.w3-teal
    h1 Lista de Géneros
  .w3-container
    table.w3-table-all.w3-margin-top
      tr.w3-teal
        th ID
        th Designação
        th N.º Filmes
      each g in generos
        tr
          td= g._id
          td= g.designacao
          td= g.filmes ? g.filmes.length : 0
    br
    a.w3-button.w3-teal(href="/") Voltar